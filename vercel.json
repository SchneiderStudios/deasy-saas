{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "env": {
    "ANTHROPIC_API_KEY": "@anthropic_api_key",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "@stripe_pk",
    "STRIPE_SECRET_KEY": "@stripe_sk",
    "DATABASE_URL": "@database_url"
  },
  "functions": {
    "pages/api/**/*.ts": {
      "runtime": "nodejs18.x",
      "maxDuration": 60
    }
  }
}
